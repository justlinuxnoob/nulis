<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below. Backup is off anyway (allowBackup="false"); this is here so the
    intent is written down in both places rather than only the modern one.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
