<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing Nulis stores leaves the phone, including through a cloud backup or a device
    transfer. The user's own backup file (Settings, Backup) is the way to move a setup, and it
    is written where they choose, by them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
